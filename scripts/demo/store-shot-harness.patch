+    #if DEBUG
+    /// Draws a capital loop around "t" and never lifts, so the trail stays on screen.
+    @MainActor
+    private func replayStoreShotLoop(ctx: GestureLayoutContext) async {
+        try? await Task.sleep(nanoseconds: 3_000_000_000)
+        let t = CGPoint(x: ctx.layoutOriginX + 0.5 * ctx.keySide * 78 / 72,
+                        y: ctx.stripHeight + 2.5 * ctx.keySide + 2)
+        let radius = ctx.keySide * 0.26
+        let points = (0...40).map { i -> CGPoint in
+            let angle = -Double.pi / 2 + Double(i) / 36 * .pi * 2
+            return CGPoint(x: t.x + radius * cos(angle), y: t.y + radius * sin(angle))
+        }
+        beginLogicalGesture(at: points[0], ctx: ctx)
+        for point in points.dropFirst() {
+            try? await Task.sleep(nanoseconds: 25_000_000)
+            continueLogicalGesture(at: point, ctx: ctx)
+        }
+    }
+    #endif
