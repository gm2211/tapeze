+    @MainActor
+    private func replayReadmeDemo(ctx: GestureLayoutContext) async {
+        func wait(_ seconds: Double) async { try? await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000)) }
+        func caption(_ title: String, _ detail: String) {
+            NotificationCenter.default.post(name: Notification.Name("ReadmeDemoCaption"), object: nil,
+                userInfo: ["caption": title, "detail": detail])
+        }
+        func center(_ row: Int, _ col: Int) -> CGPoint {
+            CGPoint(x: ctx.layoutOriginX + (CGFloat(col) + 0.5) * ctx.keySide + CGFloat(col),
+                    y: ctx.stripHeight + (CGFloat(row) + 0.5) * ctx.keySide + CGFloat(row))
+        }
+        func line(_ start: CGPoint, _ end: CGPoint, count: Int = 24) -> [CGPoint] {
+            (0...count).map { i in
+                let t = CGFloat(i) / CGFloat(count)
+                return CGPoint(x: start.x + (end.x-start.x)*t, y: start.y + (end.y-start.y)*t)
+            }
+        }
+        func replay(_ points: [CGPoint], duration: Double) async {
+            guard let first = points.first, let last = points.last else { return }
+            demoTouch = first
+            beginLogicalGesture(at: first, ctx: ctx)
+            for point in points.dropFirst() {
+                await wait(duration / Double(max(points.count-1, 1)))
+                demoTouch = point
+                continueLogicalGesture(at: point, ctx: ctx)
+            }
+            finishLogicalGesture(at: last, ctx: ctx)
+            await wait(0.12)
+            demoTouch = nil
+        }
+        func tap(_ row: Int, _ col: Int) async {
+            let p = center(row, col)
+            await replay([p, p], duration: 0.15)
+        }
+        await wait(3)
+        caption("Loop for capitals", "Circle a key to type its capital.")
+        await wait(0.55)
+        let t = center(2, 0)
+        let radius = ctx.keySide * 0.22
+        let circle = (0...36).map { i in
+            let angle = Double(i) / 36 * .pi * 2
+            return CGPoint(x: t.x + radius * cos(angle), y: t.y + radius * sin(angle))
+        }
+        await replay(circle, duration: 0.90)
+        await wait(0.55)
+        caption("Tap large letters", "One tap. One letter.")
+        await wait(0.4)
+        await tap(0, 0)
+        await wait(0.65)
+        caption("Swipe to small letters", "Slide toward p, then lift.")
+        await wait(0.45)
+        let o = center(1, 1)
+        await replay(line(o, CGPoint(x: o.x + ctx.keySide*0.32, y: o.y - ctx.keySide*0.32)), duration: 0.48)
+        await wait(0.65)
+        caption("Keep the rhythm", "Tap e. Swipe z. Tap e.")
+        await wait(0.3)
+        await tap(2, 1)
+        await wait(0.3)
+        let e = center(2, 1)
+        await replay(line(e, CGPoint(x: e.x + ctx.keySide*0.34, y: e.y)), duration: 0.45)
+        await wait(0.3)
+        await tap(2, 1)
+        await wait(0.4)
+        caption("Swipe across for space", "Cross all three keys in a row.")
+        await wait(0.5)
+        await replay(line(CGPoint(x: ctx.layoutOriginX+ctx.keySide*0.2, y: center(1, 0).y),
+            CGPoint(x: ctx.layoutOriginX+ctx.keySide*2.8+2, y: center(1, 0).y)), duration: 0.75)
+        await wait(0.55)
+        caption("Tap to keep typing", "h · i · s")
+        await wait(0.35)
+        await tap(1, 0)
+        await wait(0.25)
+        await tap(0, 2)
+        await wait(0.25)
+        await tap(2, 2)
+        await wait(0.4)
+        caption("Swipe down to delete", "Cross three keys to erase one letter.")
